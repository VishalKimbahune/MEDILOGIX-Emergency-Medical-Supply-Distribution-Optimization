# MEDILOGIX Backend Environment Configuration
# Copy this file to backend/.env and adjust for your environment.
# NEVER commit actual credentials.

APP_NAME=MEDILOGIX API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# Database Connection String
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://medilogix_user:change_me@localhost:5432/medilogix_db
# For quick local development (SQLite):
DATABASE_URL=sqlite:///./medilogix_dev.db

# CORS Allowed Origins (comma-separated) & Frontend URL
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

# Authentication & JWT Security (replace with a strong 32+ character secret!)
JWT_SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
AUTH_COOKIE_SECURE=false

# SMTP Email Configuration for Password Reset & Verification (leave SMTP_HOST blank for dev console links)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@medilogix.local
SMTP_USE_TLS=true

# Configurable Geographical Scope (Default: Pune Urban & Pimpri-Chinchwad)
GEO_REGION_NAME=Pune Urban & Pimpri-Chinchwad
GEO_MIN_LAT=18.40
GEO_MAX_LAT=18.70
GEO_MIN_LON=73.70
GEO_MAX_LON=74.05

# Synthetic Dataset Directory (relative to repository root or absolute path)
SYNTHETIC_DATA_DIR=../data/synthetic

# OpenStreetMap / Overpass Road Network Configuration (Phase 5A)
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_CACHE_FILE=../data/processed/pune_osm_road_graph.json
OSM_REQUEST_TIMEOUT_SEC=45
OSM_MAX_SNAP_DISTANCE_KM=2.5
