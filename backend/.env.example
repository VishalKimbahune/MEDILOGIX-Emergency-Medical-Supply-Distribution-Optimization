# MEDILOGIX Backend Environment Configuration
# Copy this file to backend/.env and adjust for your environment.
# NEVER commit actual credentials.

APP_NAME=MEDILOGIX API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# Database Connection String
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://medilogix_user:change_me@localhost:5432/medilogix_db
# For quick local development (SQLite):
DATABASE_URL=sqlite:///./medilogix_dev.db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configurable Geographical Scope (Default: Pune Urban & Pimpri-Chinchwad)
GEO_REGION_NAME=Pune Urban & Pimpri-Chinchwad
GEO_MIN_LAT=18.40
GEO_MAX_LAT=18.70
GEO_MIN_LON=73.70
GEO_MAX_LON=74.05

# Synthetic Dataset Directory (relative to repository root or absolute path)
SYNTHETIC_DATA_DIR=../data/synthetic
