# MEDILOGIX Root Environment Template
# Copy relevant variables into backend/.env and frontend/.env
# NEVER commit actual passwords or secrets.

# Application Environment
APP_ENV=development
APP_NAME=MEDILOGIX
DEBUG=true

# Database (PostgreSQL recommended for production; SQLite supported for local development)
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://medilogix_user:change_me@localhost:5432/medilogix_db
DATABASE_URL=sqlite:///./medilogix_dev.db

# Backend API
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

# Authentication & JWT Security (generate a strong 32+ char secret before deployment)
JWT_SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
AUTH_COOKIE_SECURE=false

# SMTP Email Delivery for Password Reset / Verification (leave SMTP_HOST blank for dev console links)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@medilogix.local
SMTP_USE_TLS=true

# Geographical Boundary Configuration (Default: Pune Urban & Pimpri-Chinchwad)
GEO_REGION_NAME=Pune Urban & Pimpri-Chinchwad
GEO_MIN_LAT=18.40
GEO_MAX_LAT=18.70
GEO_MIN_LON=73.70
GEO_MAX_LON=74.05

# OpenStreetMap Road Network Caching (© OpenStreetMap contributors, ODbL 1.0)
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_CACHE_FILE=../data/processed/pune_osm_road_graph.json
OSM_REQUEST_TIMEOUT_SEC=65
OSM_MAX_SNAP_DISTANCE_KM=2.5
OSM_USER_AGENT=MEDILOGIX-Academic-OR-Prototype/1.0

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api
